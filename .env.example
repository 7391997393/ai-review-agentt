# Copy to .env for local runs. Never commit real values.

# --- LLM: Capgemini Generative Engine (OpenAI-compatible API) ---
CG_API_KEY=
CG_MODEL=gpt-oss-120b
# Optional: defaults to the Capgemini endpoint below when empty.
CG_BASE_URL=https://openai.generative.engine.capgemini.com/v1
# Optional: maximum tokens the model may generate (default 8192).
CG_MAX_OUTPUT_TOKENS=8192

# --- GitHub ---
# Personal access token with pull-request write access on the target repository.
# GH_PAT or GITHUB_PAT are accepted as alternatives.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Pull request to review (in GitHub Actions this comes from the event).
PR_NUMBER=

# --- Optional behaviour ---
# Maximum characters of PR context sent to the model (default 120000).
MAX_REVIEW_CONTEXT_CHARS=120000
# Reopen resolved AI threads whose finding is reported again (default false).
REOPEN_RESOLVED_THREADS=false
# Extra accounts that posted AI comments for this agent before (comma-separated),
# e.g. github-actions[bot]. Their AI-format threads are treated as the agent's own.
AGENT_LOGINS=
# How to start the GitHub MCP server: "docker" (default) or a local binary path.
GITHUB_MCP_COMMAND=docker
# Docker image of the GitHub MCP server (default: pinned tested release).
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v2.0.3
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
